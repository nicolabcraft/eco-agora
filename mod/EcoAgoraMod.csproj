<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Meme cible que le serveur : runtimeconfig.json du bundle annonce net10.0. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>EcoAgoraMod</AssemblyName>
    <RootNamespace>EcoAgora</RootNamespace>
    <Version>1.2.0</Version>
    <Product>Eco Agora</Product>
    <Copyright>Copyright (c) 2026 Nicolas Abrantes - PolyForm Noncommercial 1.0.0</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Le serveur fournit deja toutes les dependances : on ne copie rien a cote. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- CA1416 : faux positifs de plateforme sur les assemblies du jeu.
         MSB3277/NU1904 : LiteDB sert uniquement a compiler ; a l'execution c'est
         la copie du serveur (5.0.11.1, plus recente) qui est chargee. -->
    <NoWarn>$(NoWarn);CS1591;CA1416;MSB3277;NU1904</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <!-- ASP.NET Core est deja charge par le serveur : reference de framework, sans copie. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    Assemblies du jeu : paquet NuGet officiel de Strange Loop Games, rien a
    installer. Pour une autre version d'Eco : -p:EcoVersion=<version NuGet>
    (liste : https://www.nuget.org/packages/Eco.ReferenceAssemblies).
  -->
  <PropertyGroup>
    <EcoVersion Condition="'$(EcoVersion)' == ''">0.14.2.1-beta-release-1106</EcoVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Eco.ReferenceAssemblies" Version="$(EcoVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Bibliotheques deja embarquees dans le serveur : utilisees a la compilation, jamais livrees. -->
  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.11" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
