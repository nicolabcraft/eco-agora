<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Meme cible que le serveur : runtimeconfig.json du bundle annonce net10.0. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>EcoAgoraMod</AssemblyName>
    <RootNamespace>EcoAgora</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Eco Agora</Product>
    <Copyright>Copyright (c) 2026 Nicolas Abrantes - PolyForm Noncommercial 1.0.0</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Le serveur fournit deja toutes les dependances : on ne copie rien a cote. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- CA1416 : faux positifs de plateforme sur les assemblies du jeu.
         MSB3277/NU1904 : LiteDB sert uniquement a compiler ; a l'execution c'est
         la copie du serveur (5.0.11.1, plus recente) qui est chargee. -->
    <NoWarn>$(NoWarn);CS1591;CA1416;MSB3277;NU1904</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <!-- ASP.NET Core est deja charge par le serveur : reference de framework, sans copie. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    Assemblies du jeu : celles de l'EcoModKit officiel, livre avec le serveur
    (<serveur>/EcoModKit/ReferenceAssemblies). Indiquez la racine du serveur :
      dotnet build -c Release -p:EcoServerDir="D:/MonServeurEco"
    ou la variable d'environnement ECO_SERVER_DIR, ou un fichier local.props
    (non versionne) qui definit EcoServerDir.
  -->
  <Import Project="local.props" Condition="Exists('local.props')" />
  <PropertyGroup>
    <EcoServerDir Condition="'$(EcoServerDir)' == ''">$(ECO_SERVER_DIR)</EcoServerDir>
    <EcoRefs>$(EcoServerDir)/EcoModKit/ReferenceAssemblies</EcoRefs>
  </PropertyGroup>
  <Target Name="VerifierEcoModKit" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(EcoRefs)/Eco.Gameplay.dll')"
           Text="EcoModKit introuvable dans '$(EcoRefs)'. Indiquez la racine du serveur Eco : -p:EcoServerDir=... ou ECO_SERVER_DIR (le dossier EcoModKit est fourni avec le serveur)." />
  </Target>

  <ItemGroup>
    <Reference Include="Eco.Core"><HintPath>$(EcoRefs)/Eco.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Eco.Gameplay"><HintPath>$(EcoRefs)/Eco.Gameplay.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Eco.ModKit"><HintPath>$(EcoRefs)/Eco.ModKit.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Eco.Plugins"><HintPath>$(EcoRefs)/Eco.Plugins.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Eco.Shared"><HintPath>$(EcoRefs)/Eco.Shared.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Eco.Simulation"><HintPath>$(EcoRefs)/Eco.Simulation.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Eco.Stats"><HintPath>$(EcoRefs)/Eco.Stats.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Eco.WebServer"><HintPath>$(EcoRefs)/Eco.WebServer.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Eco.World"><HintPath>$(EcoRefs)/Eco.World.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Bibliotheques deja embarquees dans le serveur : utilisees a la compilation, jamais livrees. -->
  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.11" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
